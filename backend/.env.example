# ==========================================
# backend/.env.example
# ==========================================
# ეს ფაილი დოკუმენტაციისთვისაა — ნამდვილი მნიშვნელობები არასდროს
# იწერება აქ, არასდროს commit-დება. ნამდვილი backend/.env
# (.gitignore-ით დაცული, root .gitignore-ის 16.08.2026-ის
# secrets-leak incident-ის შემდეგ) ინახავს რეალურ მნიშვნელობებს.

# არსებული (production/local DB)
DATABASE_URL=
SENTRY_DSN=

# Neon branch-ზე migration-ის ტესტირების სკრიპტისთვის
# (npm run test-migration -- <ფაილი.sql>, იხ. src/test-migration-on-branch.ts)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH=production
